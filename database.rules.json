{
  "rules": {
    "stores": {
      "$store_id": {
        ".read": "auth != null && root.child('stores').child($store_id).child('members').child(auth.uid).exists()",
        ".write": "auth != null && root.child('stores').child($store_id).child('members').child(auth.uid).exists()",
        "members": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "presence": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    }
  }
}
