# Salin file ini menjadi .env lalu isi. Jangan dibagikan / diunggah ke GitHub.
# --- Firebase (Firebase Console > Project settings > Your apps > Web app) ---
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# --- Gemini (https://aistudio.google.com/apikey) untuk fitur Import Chat WA ---
EXPO_PUBLIC_GEMINI_API_KEY=
# Opsional. Isi hanya bila model bawaan sudah dimatikan Google.
# EXPO_PUBLIC_GEMINI_MODEL=gemini-3.1-flash-lite
